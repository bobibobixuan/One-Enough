{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "${mod_url}",
		"issues": "${issue_tracker_url}"
	},
	"license": "${mod_license}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"top.bobixuan.OneEnoughFabric"
		]
	},
	"mixins": [
		"one-enough-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"fabric-language-kotlin": ">=1.11.0+kotlin.2.0.0",
		"minecraft": "~${minecraft_version}"
	}
}